# Server-side only. The proxy route injects this; it never reaches the browser.
OPENAI_API_KEY=sk-...

# Optional: point at an OpenAI-compatible endpoint (a router, vLLM, Ollama).
# OPENAI_BASE_URL=https://api.openai.com/v1

# Optional OpenAI-compatible / oneAPI profile. Both values stay server-side.
# OPENAI_COMPATIBLE_BASE_URL=https://oneapi.example.com/v1
# OPENAI_COMPATIBLE_API_KEY=sk-...

# Optional Anthropic server profile.
# ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
# ANTHROPIC_API_KEY=sk-ant-...
