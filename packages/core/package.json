{
  "name": "@zzyzxlabs/super-chat-core",
  "version": "0.1.0",
  "description": "Provider-agnostic agent core: content model, skills, context assembly, tools, runtime, and hand-rolled provider adapters.",
  "license": "Apache-2.0",
  "author": "ZzyzxLabs",
  "homepage": "https://github.com/ZzyzxLabs/super-chat/tree/main/packages/core#readme",
  "bugs": { "url": "https://github.com/ZzyzxLabs/super-chat/issues" },
  "keywords": ["agent", "llm", "ai", "openai", "anthropic", "tool-calling", "streaming", "context-window", "skills", "framework"],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./openai": {
      "types": "./dist/openai.d.ts",
      "import": "./dist/openai.js"
    },
    "./anthropic": {
      "types": "./dist/anthropic.d.ts",
      "import": "./dist/anthropic.js"
    }
  },
  "files": ["dist", "LICENSE", "NOTICE"],
  "repository": {
    "type": "git",
    "url": "https://github.com/ZzyzxLabs/super-chat.git",
    "directory": "packages/core"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "pnpm run build",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  }
}
