  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "@zzyzxlabs/super-chat-core": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "^19.0.2",
    "react": "^19.0.0",
